{
  "name": "@psychometr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-api-tests.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/cli/migrate.ts",
    "admin:create": "node --env-file-if-exists=../../.env --import tsx src/cli/create-admin.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@psychometr/shared": "workspace:*",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7",
    "@fastify/cookie": "11.1.3",
    "@node-rs/argon2": "2.2.2",
    "jose": "6.2.12",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.4",
    "@types/pg": "8.23.1",
    "embedded-postgres": "16.14.0-beta.17"
  }
}
