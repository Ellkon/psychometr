# Runtime / non-secret settings
NODE_ENV=
HOST=
PORT=
LOG_LEVEL=
PUBLIC_ORIGIN=
APP_HOST=
TRUST_PROXY=

# Runtime connects only as app; migrations use a separate role.
DATABASE_URL=
MIGRATION_DATABASE_URL=
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=

# Independent cryptographically random 32-byte keys, canonical base64.
APP_ENCRYPTION_KEY=
JWT_ACCESS_SECRET=
# Bearer token for the Prometheus scrape of /metrics (internal network only). Empty: no endpoint.
METRICS_TOKEN=

# Approved consent (UTF-8 file). Both optional, but no patient activation without them.
CONSENT_VERSION=
CONSENT_TEXT_PATH=

# Initial administrator bootstrap only. Remove plaintext credentials afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local tooling / e2e (not consumed by the API)
API_PROXY_TARGET=
WEB_BASE_URL=
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
LOCAL_E2E=
E2E_ENV_FILE=
# Backups (S-10): age public key for encryption; private key path only on the restore host.
AGE_RECIPIENT=
AGE_IDENTITY_PATH=
BACKUP_DIR=
BACKUP_UID=
BACKUP_GID=
