# HTTPS-only entry point. No request objects (URI, cookies, headers) in logs.
{
	admin off
	log default {
		format filter {
			wrap json
			fields {
				request delete
			}
		}
	}
}

https://{$APP_HOST:localhost} {
	tls internal
	encode zstd gzip
	header {
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=15552000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
	@private path /api/* /ws /i/* /invite /login /patient-login /patients/* /admin /audit
	header @private Cache-Control "no-store"
	handle /api/* {
		reverse_proxy api:3000
	}
	# WebSocket alerts (FR-8.1): Caddy upgrades the connection itself.
	handle /ws {
		reverse_proxy api:3000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
