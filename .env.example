# PostgreSQL
POSTGRES_DB=kompas
POSTGRES_USER=kompas
POSTGRES_PASSWORD=
# For local `pnpm dev`: docker compose -f compose.yaml -f compose.dev.yaml up -d postgres
DATABASE_URL=
POSTGRES_PORT=

# API
API_PORT=3000
LOG_LEVEL=info

# Caddy: domain for production (auto TLS), "localhost" for local, ":8080" for plain HTTP (CI)
SITE_ADDRESS=localhost
