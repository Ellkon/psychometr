# API (apps/api)
# Non-secret values have defaults in code; secrets must never be committed.
NODE_ENV=
HOST=
PORT=
LOG_LEVEL=

# Database (drizzle / postgres)
DATABASE_URL=

# PostgreSQL docker service (infra/docker-compose.yml)
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=

# Application secrets (stage 2+: patient_identity encryption, sessions, invites)
APP_ENCRYPTION_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
