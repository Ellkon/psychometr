# HTTPS for secure auth cookies; HTTP loopback is solely for the ZAP baseline.
{
	admin off
	log default {
		format filter {
			wrap json
			fields {
				request delete
			}
		}
	}
}
(ci-app) {
	encode zstd gzip
	header {
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' wss://localhost:*; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
	@private path /api/* /ws /i/* /invite /login /patient-login /patients/* /admin /audit
	header @private Cache-Control "no-store"
	# PWA shell: the browser must revalidate it, or an old build (and its service worker) lingers.
	@shell path / /index.html /sw.js /registerSW.js /manifest.webmanifest
	header @shell Cache-Control "no-cache"
	# Build assets carry a content hash in their name.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	handle /api/* {
		reverse_proxy api:3000
	}
	# WebSocket alerts (FR-8.1): Caddy upgrades the connection itself.
	handle /ws {
		reverse_proxy api:3000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
http://:80 {
	import ci-app
}
https://localhost {
	tls internal
	header Strict-Transport-Security "max-age=15552000; includeSubDomains"
	import ci-app
}
